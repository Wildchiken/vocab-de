{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocab-de",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node scripts/build-sw.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // every request goes through the Worker, which adds the security headers to the assets
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocab-de",
      // from `npx wrangler d1 create vocab-de`
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
  // secrets: npx wrangler secret put SYNC_TOKEN
}
